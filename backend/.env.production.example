APP_NAME="Facturation Clinique Naby"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://gestionclinique.cliniquenaby.com:7778

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=16

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# DB_HOST=db -> nom du service docker-compose (pas 127.0.0.1)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=facturation_clinique
DB_USERNAME=clinique_app
DB_PASSWORD=change_moi_meme_valeur_que_.env_docker

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

# A regenerer pour la prod (ne jamais reutiliser les secrets de dev) :
#   docker compose -f docker-compose.prod.yml run --rm app php artisan jwt:secret --force
JWT_SECRET=
JWT_TTL=1440
JWT_REFRESH_TTL=10080

# Origine du frontend (port 7777), en https une fois les certificats obtenus.
CORS_ALLOWED_ORIGINS=https://gestionclinique.cliniquenaby.com:7777

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
