# Copier ce fichier en ".env" a la racine du projet (a cote de docker-compose.prod.yml).
# Ce fichier est lu automatiquement par "docker compose" (ne pas confondre avec backend/.env).

# --- Base de donnees (conteneur MySQL) ---
DB_DATABASE=facturation_clinique
DB_USERNAME=clinique_app
DB_PASSWORD=change_moi_mot_de_passe_app
DB_ROOT_PASSWORD=change_moi_mot_de_passe_root

# --- Frontend ---
# URL publique du backend (port 7778), utilisee au moment du build React.
# Utiliser https:// une fois les certificats obtenus (voir DEPLOY.md).
REACT_APP_API_BASE_URL=http://gestionclinique.cliniquenaby.com:7778/api

# --- Nginx ---
# nginx.http.conf au premier demarrage (avant certbot), puis nginx.ssl.conf
# une fois les certificats Let's Encrypt obtenus.
NGINX_CONF=nginx.http.conf
